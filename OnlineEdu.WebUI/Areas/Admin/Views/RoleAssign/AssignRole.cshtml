@model List<AssignRoleDto>

@{
    ViewData["Title"] = "Rol Atama Sayfası";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<form method="post" asp-action="AssignRole" asp-controller="RoleAssign" asp-area="Admin">
    @for (int i = 0; i < Model.Count; i++)
    {
        <div class="form-check">
            <input type="hidden" asp-for="@Model[i].UserId" />
            <input type="hidden" asp-for="@Model[i].RoleId" />
            <input type="hidden" asp-for="@Model[i].RoleName" />
            <input type="checkbox" class="form-check-input" asp-for="@Model[i].RoleExist" />
            <label class="form-check-label" for="@Model[i].RoleExist">@Model[i].RoleName</label>
        </div>
    }
    <button class ="btn btn-outline-primary">Rolleri Ata</button>
</form>