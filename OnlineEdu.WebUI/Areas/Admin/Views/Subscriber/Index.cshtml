@model List<ResultSubscriberDto>

@{
    ViewData["Title"] = "Aboneler";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .wrap {
        padding: 1.5rem 0;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .page-title {
        font-size: 16px;
        font-weight: 500;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }

    .badge-count {
        background: #f5f5f4;
        border: 0.5px solid #e0e0de;
        border-radius: 20px;
        font-size: 12px;
        color: #6b6b68;
        padding: 2px 10px;
    }

    .tbl-card {
        background: #ffffff;
        border: 0.5px solid #e0e0de;
        border-radius: 12px;
        overflow: hidden;
    }

        .tbl-card table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin-bottom: 0;
        }

        .tbl-card thead tr {
            background: #f9f9f8;
        }

        .tbl-card thead th {
            padding: 10px 16px;
            font-size: 11px;
            font-weight: 500;
            color: #888780;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-bottom: 0.5px solid #e0e0de;
            border-top: none;
            text-align: left;
        }

        .tbl-card tbody tr {
            border-bottom: 0.5px solid #ebebea;
            transition: background 0.12s;
        }

            .tbl-card tbody tr:last-child {
                border-bottom: none;
            }

            .tbl-card tbody tr:hover {
                background: #f9f9f8;
            }

        .tbl-card td {
            padding: 13px 16px;
            font-size: 13px;
            color: #1a1a1a;
            vertical-align: middle;
            border-top: none;
        }

    .num-cell {
        color: #b4b2a9;
        font-size: 12px;
        font-weight: 500;
        width: 44px;
    }

    .badge-aktif {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #EAF3DE;
        color: #3B6D11;
        border: 0.5px solid #97C459;
        border-radius: 20px;
        padding: 3px 10px;
        font-size: 11px;
        font-weight: 500;
    }

    .badge-pasif {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #FAEEDA;
        color: #854F0B;
        border: 0.5px solid #EF9F27;
        border-radius: 20px;
        padding: 3px 10px;
        font-size: 11px;
        font-weight: 500;
    }

    .badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        display: inline-block;
    }

    .actions {
        display: flex;
        gap: 6px;
        justify-content: flex-end;
    }

    .btn-del {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 0.5px solid #F09595;
        background: transparent;
        color: #A32D2D;
        border-radius: 8px;
        padding: 5px 11px;
        font-size: 12px;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.12s;
    }

        .btn-del:hover {
            background: #FCEBEB;
            color: #A32D2D;
            text-decoration: none;
        }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 0.5px solid #d0d0ce;
        background: transparent;
        color: #6b6b68;
        border-radius: 8px;
        padding: 5px 11px;
        font-size: 12px;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.12s;
    }

        .btn-cancel:hover {
            background: #f5f5f4;
            color: #1a1a1a;
            text-decoration: none;
        }

    .btn-approve {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 0.5px solid #97C459;
        background: transparent;
        color: #3B6D11;
        border-radius: 8px;
        padding: 5px 11px;
        font-size: 12px;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.12s;
    }

        .btn-approve:hover {
            background: #EAF3DE;
            color: #3B6D11;
            text-decoration: none;
        }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #b4b2a9;
        font-size: 13px;
    }

        .empty-state i {
            font-size: 32px;
            display: block;
            margin-bottom: 10px;
            opacity: 0.5;
        }

    /* Modal */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        z-index: 1050;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.open {
            display: flex;
        }

    .modal-box {
        background: #ffffff;
        border: 0.5px solid #e0e0de;
        border-radius: 12px;
        padding: 1.5rem;
        width: 360px;
        max-width: 90%;
    }

    .modal-icon {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #FCEBEB;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }

        .modal-icon i {
            font-size: 20px;
            color: #A32D2D;
        }

    .modal-box h5 {
        font-size: 15px;
        font-weight: 500;
        color: #1a1a1a;
        margin-bottom: 6px;
    }

    .modal-box p {
        font-size: 13px;
        color: #6b6b68;
        margin-bottom: 1.25rem;
        line-height: 1.6;
    }

    .modal-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .btn-modal-cancel {
        border: 0.5px solid #d0d0ce;
        background: transparent;
        color: #6b6b68;
        border-radius: 8px;
        padding: 7px 14px;
        font-size: 13px;
        cursor: pointer;
    }

    .btn-modal-del {
        border: none;
        background: #A32D2D;
        color: #fff;
        border-radius: 8px;
        padding: 7px 14px;
        font-size: 13px;
        cursor: pointer;
        transition: opacity 0.12s;
    }

        .btn-modal-del:hover {
            opacity: 0.85;
        }
</style>

<div class="wrap">
    <div class="page-header">
        <div class="header-left">
            <h4 class="page-title">
                <i class="bi bi-envelope"></i>
                Aboneler
            </h4>
            <span class="badge-count">@Model.Count kayıt</span>
        </div>
    </div>

    <div class="tbl-card">
        <table>
            <thead>
                <tr>
                    <th style="width:44px;">#</th>
                    <th>Email</th>
                    <th style="width:160px;">Durum</th>
                    <th style="width:200px; text-align:right;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4">
                            <div class="empty-state">
                                <i class="bi bi-inbox"></i>
                                Henüz abone yok.
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    int count = 0;
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <td class="num-cell">@count</td>
                            <td>@item.Email</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge-aktif">
                                        <span class="badge-dot"></span>
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-pasif">
                                        <span class="badge-dot"></span>
                                        Onay bekliyor
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="actions">
                                    <a href="javascript:void(0)"
                                       onclick="askDelete('@item.SubscriberId', '@item.Email')"
                                       class="btn-del">
                                        <i class="bi bi-trash3"></i> Sil
                                    </a>

                                    @if (item.IsActive)
                                    {
                                        <a asp-action="ChangeStatusSubscriber"
                                           asp-controller="Subscriber"
                                           asp-area="Admin"
                                           asp-route-id="@item.SubscriberId"
                                           class="btn-cancel">
                                            <i class="bi bi-slash-circle"></i> İptal et
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="ChangeStatusSubscriber"
                                           asp-controller="Subscriber"
                                           asp-area="Admin"
                                           asp-route-id="@item.SubscriberId"
                                           class="btn-approve">
                                            <i class="bi bi-check-circle"></i> Onayla
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Silme Onay Modalı -->
<div class="modal-overlay" id="del-modal">
    <div class="modal-box">
        <div class="modal-icon">
            <i class="bi bi-trash3"></i>
        </div>
        <h5>Abone silinsin mi?</h5>
        <p id="modal-desc">Bu aboneyi silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>
        <div class="modal-actions">
            <button class="btn-modal-cancel" onclick="closeModal()">İptal</button>
            <button class="btn-modal-del" id="confirm-del-btn">Evet, sil</button>
        </div>
    </div>
</div>

<script>
    var pendingDeleteUrl = null;

    function askDelete(id, email) {
        pendingDeleteUrl = '/Admin/Subscriber/DeleteSubscriber/' + id;
        document.getElementById('modal-desc').textContent =
            '"' + email + '" adresini silmek istediğinize emin misiniz? Bu işlem geri alınamaz.';
        document.getElementById('del-modal').classList.add('open');
    }

    function closeModal() {
        pendingDeleteUrl = null;
        document.getElementById('del-modal').classList.remove('open');
    }

    document.getElementById('confirm-del-btn').addEventListener('click', function () {
        if (pendingDeleteUrl) {
            window.location.href = pendingDeleteUrl;
        }
    });

    document.getElementById('del-modal').addEventListener('click', function (e) {
        if (e.target === this) closeModal();
    });
</script>
