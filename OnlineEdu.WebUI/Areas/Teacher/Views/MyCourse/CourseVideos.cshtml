@model List<ResultCourseVideoDto>

@{
    ViewData["Title"] = "Kurs Videoları";
    Layout = "~/Areas/Teacher/Views/TeacherLayout/Index.cshtml";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .course-title {
        font-size: 24px;
        font-weight: 700;
        color: #1f2937;
    }

    .video-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(320px,1fr));
        gap: 24px;
    }

    .video-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        overflow: hidden;
        transition: all .25s ease;
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }

        .video-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(0,0,0,.08);
        }

    .video-frame {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%;
    }

        .video-frame iframe {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }

    .video-body {
        padding: 16px;
    }

    .video-number {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #EEF6FF;
        color: #2563EB;
        border-radius: 999px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .video-title {
        font-size: 15px;
        font-weight: 600;
        color: #111827;
        margin: 0;
    }

    .empty-state {
        text-align: center;
        padding: 60px;
        border: 1px dashed #d1d5db;
        border-radius: 16px;
        color: #9ca3af;
        background: #fafafa;
    }

    .back-btn {
        margin-top: 24px;
    }
</style>

<div class="page-header">
    <div>
        <div class="course-title">
            🎓 @ViewBag.courseName
        </div>
    </div>
</div>


<div class="tbl-wrap">
    <table>
        <thead>
            <tr>
                <th style="width:44px;">#</th>
                <th>Video</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" style="text-align:center; padding:2.5rem; color:#b4b2a9; font-size:13px;">
                        Henüz eğitmen tarafından video eklenmemiş.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="num-cell">@item.VideoNumber</td>
                        <td>
                            <div class="desc-cell"><iframe width="560" height="315" src="@item.VideoUrl" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<a href="/Teacher/MyCourse/CreateVideo/" class="btn btn-outline-primary">Kursa Yeni Video Ekle</a>





