@model CreateCourseVideoDto

@{
    ViewData["Title"] = "Kurs'a Video Ekle";
    Layout = "~/Areas/Teacher/Views/TeacherLayout/Index.cshtml";
}

<h3><strong>@ViewBag.courseName</strong></h3>  
<br/>

<form method="post">
    <input type="hidden" name="CourseId" value="@ViewBag.courseId" />
    <label>Video Sıra No</label>
    <input type="number" asp-for="VideoNumber" class="form-control" required />
    <br />
    <label>Video Url</label>
    <input type="text" asp-for="VideoUrl" class="form-control" required />
    <br />   
    <button type="submit" class="btn btn-primary">Video Ekle</button>
</form>